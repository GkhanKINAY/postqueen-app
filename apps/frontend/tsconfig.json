{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The base sets Node10 resolution, which predates the `exports` field and
    // so cannot find the types of any package that declares them there — Uppy
    // 5 and @uppy/compressor 3 among them. Node10 resolves those to nothing,
    // or worse to `any`. Turbopack already resolves this app the way a bundler
    // does, so saying so here makes the compiler agree with the build instead
    // of lagging several majors behind it.
    //
    // The backend keeps Node10: it emits CommonJS, and `bundler` is not valid
    // with `module: commonjs`.
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "../../apps/frontend/.next/types/**/*.ts",
    "../../dist/apps/frontend/.next/types/**/*.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
