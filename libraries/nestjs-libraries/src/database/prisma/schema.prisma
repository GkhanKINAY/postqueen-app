  idempotencyKey String    @unique(map: "idx_knowledge_outbox_idempotency")
  documentId     String
  documentType   String
  operation      String
  scope          Json
  scopeKey       String
  status         String
  attempts       Int
  availableAt    DateTime  @db.Timestamp(6)
  claimedAt      DateTime? @db.Timestamp(6)
  claimedBy      String?
  createdAt      DateTime  @db.Timestamp(6)
  completedAt    DateTime? @db.Timestamp(6)
  availableAtZ   DateTime? @default(now()) @db.Timestamptz(6)
  claimedAtZ     DateTime? @default(now()) @db.Timestamptz(6)
  createdAtZ     DateTime? @default(now()) @db.Timestamptz(6)
  completedAtZ   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([status, availableAt, createdAt], map: "idx_knowledge_outbox_claim")
}

