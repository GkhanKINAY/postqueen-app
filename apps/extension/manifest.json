{
  "manifest_version": 3,
  "name": "PostQueen",
  "version": "2.0.0",
  "description": "Connects your Skool account to PostQueen, so you can schedule posts to your Skool groups.",
  "icons": {
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "cookies",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
