FROM node:22.20-bookworm-slim
# Must be NEXT_PUBLIC_APP_VERSION, not NEXT_PUBLIC_VERSION. next.config.js bakes
# the former into the bundle and every reader uses it; nothing has ever read the
# latter, so the tag arrived here and went nowhere.
ARG NEXT_PUBLIC_APP_VERSION
ENV NEXT_PUBLIC_APP_VERSION=$NEXT_PUBLIC_APP_VERSION
# procps provides `ps`, which pm2 needs to kill a process tree. Without it
# `pm2 restart` stopped only the pnpm wrapper and the old node kept the port.
# ffmpeg renders the Image Text Slides video and normalizes uploaded video;
# Debian's build carries libass (burned captions) and libzimg (HDR tone
# mapping). fonts-dejavu-core is the caption font: with --no-install-recommends
# libass pulls in no font of its own.
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
    ffmpeg \
    fonts-dejavu-core \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install
# Sentry source maps. The maintainer's tag builds pass the token as a BuildKit
# secret, readable only while this RUN executes, so it never reaches the image
# history or the environment. Without it (forks, self-hosted builds) the
# frontend builds exactly as before and uploads nothing. The maps are deleted
# after the upload (next.config.js), so none are served either.
#
# The Turbopack build cache is removed in the same RUN, before the layer is
# written: Next 16 hands Turbopack the whole environment and its filesystem
# cache stores it, so the token would otherwise sit in apps/frontend/.next/cache
# of a public image. The cache is also ~740 MB nothing reads at runtime.
ARG SENTRY_ORG
ARG SENTRY_PROJECT
ARG GITHUB_SHA
RUN --mount=type=secret,id=sentry_auth_token,required=false \
    SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token 2>/dev/null)" \
    NODE_OPTIONS="--max-old-space-size=4096" pnpm run build \
 && rm -rf apps/frontend/.next/cache

CMD ["sh", "-c", "nginx && pnpm run pm2"]
